# Copy to .env and edit. Never commit .env.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/reclaim_value
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://127.0.0.1:8000
CORS_ORIGIN=http://localhost:5173

# Optional: Gemini answers general assistant questions (built-in guide is used otherwise)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: store images on Cloudinary instead of backend/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: smart-matching weights  sim,dist,price,rating
MATCH_WEIGHTS=0.4,0.25,0.2,0.15
MAX_MATCH_RADIUS_KM=50
